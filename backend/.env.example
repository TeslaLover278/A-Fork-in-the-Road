# ---------------------------------------------------------------- server
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# SQLite file. The directory is created on boot if it doesn't exist.
DATABASE_PATH=./data/fork.db

# ------------------------------------------------------------------ auth
# REQUIRED in production; 32+ characters. The server refuses to start
# without it when NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=5184000

# ---------------------------------------------------------------- banter
# OPTIONAL. Without it the server still runs and /v1/banter serves the
# scripted line bank — the same content the iOS app ships offline.
ANTHROPIC_API_KEY=

BANTER_MODEL=claude-opus-5
# low is deliberate: short, creative, latency-bound output with a driver waiting.
BANTER_EFFORT=low
BANTER_TIMEOUT_MS=8000
BANTER_CACHE_TTL_SECONDS=86400

# ----------------------------------------------------------- rate limits
# Per identity (user id when signed in, otherwise IP) per window.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BANTER=20
RATE_LIMIT_AUTH=10
RATE_LIMIT_DEFAULT=120

# ------------------------------------------------------------------ cors
# Comma-separated origins, or * to allow all.
CORS_ORIGINS=*
